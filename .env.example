# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# Random long string, e.g.: openssl rand -base64 48
JWT_SECRET=

# Credentials for the single owner account, seeded into the DB on first run
# (only used if no user exists yet — safe to leave set after that).
INITIAL_USER_EMAIL=you@example.com
INITIAL_USER_PASSWORD=change-me

# AES-256 key for encrypting holding secrets (logins/passwords), base64-encoded
# 32 bytes: openssl rand -base64 32
# Changing this after secrets exist makes them undecryptable — back it up.
ENCRYPTION_KEY=

# Anthropic API key for the holding-analysis pipeline (console.anthropic.com).
# Required — the API refuses to start without it, same as the keys above.
# Each analysis costs roughly $0.10-0.50 (Opus 5 tokens + billed web searches).
ANTHROPIC_API_KEY=

# Finnhub key (finnhub.io, free tier is enough) — OPTIONAL.
# Adds live quotes and recent news for holdings that have a ticker. Leave empty and
# analyses fall back to web search alone, which is what non-ticker assets use anyway.
FINNHUB_API_KEY=

# Minimum hours between analyses of the same holding. Optional, defaults to 12.
INSIGHTS_COOLDOWN_HOURS=
