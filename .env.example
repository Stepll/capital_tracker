# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# Random long string, e.g.: openssl rand -base64 48
JWT_SECRET=

# Credentials for the single owner account, seeded into the DB on first run
# (only used if no user exists yet — safe to leave set after that).
INITIAL_USER_EMAIL=you@example.com
INITIAL_USER_PASSWORD=change-me
